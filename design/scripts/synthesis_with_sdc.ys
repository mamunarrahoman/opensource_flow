yosys -import

set constr_file ./inputs/alu_4bit_input.sdc
set abc_script "+read_constr,-s,${constr_file};strash;ifraig;retime,-D,450,-M,6;strash;dch;map;"

# Use them normally
read_verilog -sv $::env(DESIGN_VERILOG)
read_liberty -lib $::env(LIB_PATH)
hierarchy -top $::env(DESIGN_NM)
yosys proc; fsm; opt; memory; opt
techmap ; opt
dfflibmap -liberty $::env(LIB_PATH)
#abc -liberty $::env(LIB_PATH) -script ${abc_script} -constr -s ${constr_file}
opt
flatten; opt
write_verilog $::env(SYN_DIR)/${::env(DESIGN_NM)}_mapped.v
show -color green i:* -color red o:* -format dot -prefix $::env(SYN_DIR)/${::env(DESIGN_NM)}_mapped
